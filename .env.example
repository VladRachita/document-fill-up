# Copy to .env and adjust. Every setting can also be given as an environment variable.

# Where standard documents are stored (any SQLAlchemy URL).
DOCFILL_DATABASE_URL=sqlite:///./docfill.db
# DOCFILL_DATABASE_URL=postgresql+psycopg://docfill:secret@localhost:5432/docfill

# OCR: Tesseract languages joined with '+', DPI used to rasterise scanned PDF pages.
DOCFILL_OCR_LANGUAGES=eng
DOCFILL_OCR_DPI=300
# DOCFILL_TESSERACT_CMD=/usr/bin/tesseract

# ML named-entity recognition model (spaCy). Empty disables NER.
DOCFILL_SPACY_MODEL=en_core_web_sm

# Extracted values below this confidence are not used to fill documents.
DOCFILL_MIN_CONFIDENCE=0.5

# Folder where the wizard saves the PDFs it creates.
DOCFILL_OUTPUT_DIR=output

# Upload limit in bytes (25 MB).
DOCFILL_MAX_FILE_SIZE=26214400

# TrueType font for exported PDFs (needed for ă, ș, ț ...). Auto-detected when unset.
# DOCFILL_PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
